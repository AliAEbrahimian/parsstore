# Environment file template - copy this file to ".env" in the project root.
# The .env file is listed in .gitignore and must never be committed.

# ---------------------------------------------------------------- base
# Secure default is 0; set to 1 only for local development.
DJANGO_DEBUG=0

# Required in production; generate a random 50+ character string:
# python -c "from secrets import token_urlsafe; print(token_urlsafe(64))"
DJANGO_SECRET_KEY=

# In production: the real site hostname(s), separated by commas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# If the site is behind a proxy/CDN (for example https://example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Admin panel path (no leading or trailing slash). Example: panel-x7k2
DJANGO_ADMIN_PATH=admin

# SQLite database path (optional)
DJANGO_DB_PATH=

# ---------------------------------------------------------------- security (production)
# In production set all of these to 1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Behind a trusted reverse proxy (Nginx/Cloudflare)
DJANGO_BEHIND_PROXY=0
# Only if X-Forwarded-For comes exclusively from a trusted proxy
DJANGO_TRUST_PROXY_HEADERS=0
# Number of trusted proxy hops for determining the client IP
DJANGO_TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------- rate-limit cache
# In multi-process/multi-server deployments LocMemCache is not enough: each
# worker would keep a separate counter. Enable one of the options below so all
# workers share the same rate-limit state:
# DJANGO_REDIS_URL=redis://127.0.0.1:6379/1
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache

# ---------------------------------------------------------------- inquiry form
# Allowed submissions per IP within the time window (seconds)
INQUIRY_RATE_LIMIT=6
INQUIRY_RATE_WINDOW=600

# ---------------------------------------------------------------- customer club
# Signups are less frequent than inquiries; the default window is one hour.
CLUB_RATE_LIMIT=4
CLUB_RATE_WINDOW=3600

# ---------------------------------------------------------------- products
# Maximum number of products shown on the home page (featured items first)
PRODUCTS_HOME_LIMIT=6

# Number of items per catalogue page at /products/ (clamped to 6-96)
PRODUCTS_PAGE_SIZE=24

# ---------------------------------------------------------------- email
# Each form submission sends two emails:
#   1) a confirmation to the address entered by the visitor (always)
#   2) a notification to the site owner (optional; set a recipient below)
# The default backend prints messages to the console. Configure SMTP for real mail.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
# Avoid blocking the request when SMTP is down (seconds)
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=no-reply@localhost
DJANGO_SERVER_EMAIL=

# Inquiry notification recipient (empty = customer confirmation only)
CONTACT_NOTIFY_EMAIL=
# Club signup notification recipient (empty = use CONTACT_NOTIFY_EMAIL)
CLUB_NOTIFY_EMAIL=
# If both are empty, notifications go to active staff users.

# ---------------------------------------------------------------- logging
DJANGO_LOG_LEVEL=INFO
