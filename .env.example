# نمونهٔ فایل محیطی — این فایل را در ریشهٔ پروژه به نام «.env» کپی کنید.
# فایل .env در .gitignore قرار دارد و هرگز نباید کامیت شود.

# ---------------------------------------------------------------- پایه
# در تولید حتماً روی 0 بگذارید
DJANGO_DEBUG=1

# فقط در تولید لازم است؛ یک رشتهٔ تصادفی ۵۰+ نویسه‌ای بسازید:
# python -c "from secrets import token_urlsafe; print(token_urlsafe(64))"
DJANGO_SECRET_KEY=

# در تولید: دامنهٔ واقعی سایت، جداشده با کاما
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# اگر دامنه پشت پراکسی/CDN است (مثلاً https://example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# مسیر پنل مدیریت (بدون اسلش ابتدا و انتها). مثال: panel-x7k2
DJANGO_ADMIN_PATH=admin

# مسیر پایگاه‌دادهٔ SQLite (اختیاری)
DJANGO_DB_PATH=

# ---------------------------------------------------------------- امنیت (تولید)
# در تولید همه را روی 1 بگذارید
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# اگر پشت پراکسی معتبر (Nginx/Cloudflare) هستید
DJANGO_BEHIND_PROXY=0
# فقط اگر هدر X-Forwarded-For را کاملاً به پراکسی مطمئن می‌سپارید
DJANGO_TRUST_PROXY_HEADERS=0

# ---------------------------------------------------------------- فرم استعلام
# تعداد مجاز ارسال فرم از هر IP در بازهٔ زمانی (ثانیه)
INQUIRY_RATE_LIMIT=6
INQUIRY_RATE_WINDOW=600

# ---------------------------------------------------------------- باشگاه مشتریان
# عضویت کمتر از استعلام اتفاق می‌افتد؛ پنجرهٔ پیش‌فرض یک ساعت است.
CLUB_RATE_LIMIT=4
CLUB_RATE_WINDOW=3600

# ---------------------------------------------------------------- محصولات
# حداکثر تعداد محصول نمایش‌داده‌شده در صفحهٔ اصلی (محصولات منتخب اولویت دارند)
PRODUCTS_HOME_LIMIT=6

# ---------------------------------------------------------------- ایمیل (اختیاری)
# برای ارسال واقعی: django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=no-reply@localhost
DJANGO_SERVER_EMAIL=

# اگر پر شود، برای هر استعلام یک ایمیل اطلاع‌رسانی ارسال می‌شود
CONTACT_NOTIFY_EMAIL=

# ---------------------------------------------------------------- لاگ
DJANGO_LOG_LEVEL=INFO
